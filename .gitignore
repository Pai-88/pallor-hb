# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Data — never commit real/patient data
data/**/*.csv
data/**/*.parquet
data/**/*.npy
data/**/*.npz
data/**/*.jpg
data/**/*.png
data/raw/
data/processed/

# Results are regenerated by train.py; keep the dir, ignore large artifacts
results/*.png
results/*.json
!results/.gitkeep

# ...but the CP-AnemiC figures and metrics ARE the published result: they are
# referenced from README.md/FINDINGS.md and must survive a clone.
!results/fig*.png
!results/banner.png
!results/roc_comparison.png
!results/bland_altman.png
!results/pred_vs_actual.png
!results/cp_anemic_summary.json

# Datasets are never committed. CP-AnemiC is redistributed under its own licence;
# the loader points at a local copy the user downloads.
data/cp-anemic/
*.rar

# OS / editor / local tool config
.DS_Store
.vscode/
.idea/
.claude/

# Editor local-history plugin — this is a *nested git repository*, so committing
# it would leave a broken gitlink that no clone can resolve.
.history/

# KiCad/MCP autosave churn: 20 timestamped copies of the same board file, ~11 MB.
# The board itself is tracked; its undo history is not project history.
.mcp-backups/
*.bak
*.kicad_prl
*-backups/
fp-info-cache

# Paper — local working notes and build artefacts, not part of the record
paper/DRAFTING.md
paper/SUBMIT_METADATA.md
paper/*.zip
paper/**/*.aux
paper/**/*.log
paper/**/*.out
paper/CLAIMS_TO_VERIFY.md
paper/MEETING_PREP.md

# Private meeting/glossary prep — never commit
paper/GLOSSARY.md
paper/WRITING_BRIEF.md
